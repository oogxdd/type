    "tauri:ios:sync-icons": "rsync -a src-tauri/icons/ios/ src-tauri/gen/apple/Assets.xcassets/AppIcon.appiconset/",
    "tauri:ios:sync-splash": "mkdir -p src-tauri/gen/apple/Assets.xcassets/SplashLogo.imageset && rsync -a src-tauri/icons/ios-splash/SplashLogo.imageset/ src-tauri/gen/apple/Assets.xcassets/SplashLogo.imageset/ && cp src-tauri/icons/ios-splash/LaunchScreen.storyboard src-tauri/gen/apple/LaunchScreen.storyboard",
