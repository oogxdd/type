{
  "name": "type-monorepo",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "desktop:dev": "python3 apps/gpui/scripts/desktop.py dev",
    "desktop:tauri": "npm run --workspace type tauri --",
    "desktop:build": "cargo build -p type-gpui",
    "desktop:app": "python3 apps/gpui/scripts/desktop.py dev",
    "desktop:app:prod-data": "python3 apps/gpui/scripts/desktop.py dev --production",
    "desktop:dmg:dev": "npm run desktop:tauri:dmg:dev",
    "desktop:release": "python3 apps/gpui/scripts/desktop.py bundle --release",
    "mobile:start": "npm run --workspace @typenotes/mobile start",
    "mobile:ios": "npm run --workspace @typenotes/mobile-core codegen:ios && npm run --workspace @typenotes/mobile ios",
    "mobile:ios:watch": "node scripts/watch-mobile-ios.mjs",
    "mobile:ios:dev:prebuild": "APP_VARIANT=dev npm run --workspace @typenotes/mobile prebuild -- --platform ios --clean",
    "mobile:ios:dev:device": "npm run --workspace @typenotes/mobile ios -- --device",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "mcp:build": "npm run --workspace @typenotes/notes-mcp build",
    "mcp:test": "npm run --workspace @typenotes/notes-mcp test",
    "desktop:tauri:dev": "npm run --workspace type dev",
    "desktop:tauri:build": "npm run --workspace type build",
    "desktop:tauri:app": "npm run --workspace type tauri:dev:isolated",
    "desktop:tauri:app:prod-data": "npm run --workspace type tauri -- dev",
    "desktop:tauri:dmg:dev": "npm run --workspace type tauri:build:dev",
    "desktop:tauri:release": "bash apps/desktop/scripts/release-local.sh",
    "desktop:test": "cargo test -p type-gpui -- --test-threads=1",
    "desktop:bundle": "python3 apps/gpui/scripts/desktop.py bundle"
  },
  "version": "1.0.0",
  "dependencies": {
    "expo": "~57.0.4",
    "react": "19.2.7",
    "react-native": "0.86.0"
  }
}
