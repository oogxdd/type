{
  "compilerOptions": {
    "target": "ES2020",
    // Portable like @typenotes/shared: no DOM lib, so nothing here can rely on
    // browser APIs. React Native (Hermes) is the primary runtime.
    "lib": ["ES2020"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "skipLibCheck": true,
    "isolatedModules": true,
    "noEmit": true,
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true
  },
  "include": ["src"]
}
