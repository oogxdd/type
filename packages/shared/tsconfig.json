{
  "compilerOptions": {
    "target": "ES2020",
    // No DOM lib on purpose: this package must stay portable across the Vite
    // desktop app and React Native (Hermes). Anything needing window/document
    // belongs in an app's own shared/lib instead.
    "lib": ["ES2020"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "skipLibCheck": true,
    "isolatedModules": true,
    "noEmit": true,
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true
  },
  "include": ["src"]
}
