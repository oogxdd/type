# Copy this file to `.env` and fill in. Only VITE_OTA_MANIFEST_URL is read by
# the app and the build; `.env` itself is gitignored.

# iOS OTA updates: the manifest the app fetches at startup to pull new WebView
# assets. See the "OTA updates" section in README.md. Leave unset to always run
# the bundled assets.
VITE_OTA_MANIFEST_URL=https://your-cdn.example.com/type/ota/manifest.json
