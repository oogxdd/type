{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Type",
  "version": "0.4.5",
  "identifier": "com.digital.type2",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1430",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "macOSPrivateApi": true,
    "windows": [
      {
        "title": "Type",
        "width": 800,
        "height": 600,
        "decorations": true,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "transparent": true
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": []
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "entitlements": "entitlements.plist"
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDI0OTQ5MTk0REUxMDE4MTYKUldRV0dCRGVsSkdVSk9RaXpJZGVrcXhZK1pSb2owTlF1L1hiMzg3dzMxcklRanM3ZU9qcUYvZVUK",
      "endpoints": [
        "https://github.com/oogxdd/type/releases/latest/download/latest.json"
      ]
    }
  }
}
