<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
  <dict>
    <!--
      Notarization requires the hardened runtime, and the hardened runtime denies
      microphone access unless the app explicitly asks for it — regardless of
      NSMicrophoneUsageDescription in Info.plist. Without this, audio recording
      works in unsigned local builds and silently fails in released ones.
    -->
    <key>com.apple.security.device.audio-input</key>
    <true/>
  </dict>
</plist>
