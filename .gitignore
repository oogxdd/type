# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

node_modules
dist
dist-ssr
*.local

# Cargo workspace build output (root target/ shared by all crates)
/target/

# Local environment files (keep .env.example tracked as the template)
.env

# Editor directories and files
.vscode/*
!.vscode/extensions.json
.idea
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# A profile's local notes data dir when it lives at the repo root. Anchored with
# a leading slash so it never swallows source folders named "notes" (e.g.
# src-tauri/src/adapters/notes/).
/notes/

# uniffi-bindgen-react-native codegen output (regenerated on a Mac)
packages/mobile-core/src/generated/
packages/mobile-core/cpp/
packages/mobile-core/ios/
packages/mobile-core/android/
packages/mobile-core/src/NativeTypeCore.ts
packages/mobile-core/src/index.tsx
packages/mobile-core/TypeCore.podspec
packages/mobile-core/*.xcframework/

# Expo CLI cache, prebuild artifacts, device logs
.expo/

# Root-level Expo prebuild output (stale experiment — dev builds use
# apps/mobile with APP_VARIANT=dev instead). Anchored to root so it
# never ignores apps/mobile/ios/.
/ios/
